#!/bin/sh
# PLAYBOOK drift gate - blocks any commit while the projection is stale.
# Design: arena-zcode champion run-20261005-124942-s973103; owner GO 2026-10-05.
# Covers untracked local sources too (.agents/napkin.md) via sources_revision.
status=0
python -B tools/playbook/generate-playbook.py --repo . --check || status=$?

# Release-stamp gate - blocks a commit that moved the version in some files only
# (pyproject.toml without __version__, the Action pins, the docs, uv.lock). Twice
# it reached main and left `doctor` red on every installed copy. Reads the index,
# so it judges what the commit will contain. Both gates run: one report must not
# hide the other, and any failure refuses the commit.
python -B tools/release_version.py --check --from-index || status=$?
exit $status
